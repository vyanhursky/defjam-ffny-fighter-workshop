{
  "name": "defjam-workshop-ui-checks",
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/defjam_caf/resources/*.{html,css,js,mjs}\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"src/defjam_caf/resources/*.{html,css,js,mjs}\" \"tests/*.mjs\"",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {"prettier": "3.6.2"}
}
